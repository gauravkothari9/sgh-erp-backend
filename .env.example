# =============================================
# SGH ERP — Backend Environment Variables
# Copy this file to .env and fill in values
# =============================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — primary database (Prisma)
DATABASE_URL=postgresql://sgh:sgh@localhost:5432/sgh_erp?schema=public

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=14d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
PUBLIC_BASE_URL=http://localhost:5000

# Seed bootstrap admin (used by scripts/seed-pg.js — optional)
# SEED_ADMIN_EMAIL=admin@sgh.local
# SEED_ADMIN_PASSWORD=changeme-1234
