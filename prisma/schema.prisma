// Prisma schema for SGH Crafts ERP — full Postgres stack.
// Hosts both the v2 Showroom Inventory module AND the v1 office modules
// (auth/users, customers, orders, buyer catalogue). Mongo is fully retired.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EMPLOYEE
  MANAGER
  SHOWROOM_STAFF
}

enum LocationType {
  LOCATION
  SHOWROOM
  VIRTUAL
}

enum MaterialType {
  WOOD
  IRON
  WOOD_IRON
  IRON_MARBLE
  WOOD_MARBLE
  OTHER
}

enum PieceStage {
  AVAILABLE
  IN_SHOWROOM
  RESERVED
  SOLD
  DISPATCHED
  IN_TRANSIT
  RETURNED
}

enum VoucherType {
  RECEIPT
  TRANSFER
  SALE
  RESERVATION
  RETURN
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  CONVERTED_TO_SALE
  CANCELLED
  EXPIRED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

enum OrderType {
  SAMPLE_ORDER
  REGULAR_ORDER
}

enum OrderStatus {
  DRAFT
  FINALIZED
  PENDING
  IN_PRODUCTION
  QC
  POLISH
  PACKAGING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// ─── Auth / Users ─────────────────────────────────────────────────────────────

model User {
  id                  Int       @id @default(autoincrement())
  userId              String    @unique // human-readable id (e.g. EMP-0001)
  email               String    @unique
  passwordHash        String
  fullName            String
  phone               String?
  role                Role      @default(EMPLOYEE)
  designation         String?
  department          String?
  permissions         Json      @default("{}")
  permissionsVersion  Int       @default(1)
  isActive            Boolean   @default(true)
  avatar              String?
  lastLogin           DateTime?
  lastActiveAt        DateTime?
  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?
  refreshTokenHash    String?

  // v2-specific — showroom staff assignment
  assignedLocationId Int?
  assignedLocation   Location? @relation(fields: [assignedLocationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries  StockLedger[]
  sales          ShowroomSale[]
  reservations   Reservation[]
  customersOwned Customer[]     @relation("CustomerCreatedBy")
  ordersOwned    Order[]        @relation("OrderCreatedBy")
}

// ─── v1 Office: Customers ─────────────────────────────────────────────────────

model Customer {
  id                    Int            @id @default(autoincrement())
  fileNumber            String         @unique
  companyName           String
  contactPersonName     String
  designation           String?
  agent                 String?
  photo                 String?
  country               String
  priceType             String?
  currency              String         @default("USD")
  portOfLoading         String?
  portOfDischarge       String?
  countryOfDestination  String?
  paymentTerms          String?
  shippingTerms         String?
  taxId                 String?
  notes                 String?
  customerSince         DateTime?
  status                CustomerStatus @default(ACTIVE)
  isDeleted             Boolean        @default(false)

  // Nested arrays held as JSON — schemas matched what the frontend already sends.
  emails               Json @default("[]") // [{ email, label }]
  phones               Json @default("[]") // [{ number, label, isWhatsapp }]
  shippingAddresses    Json @default("[]") // [{ label, line1, line2, city, state, country, pincode }]
  billingAddresses     Json @default("[]") // [{ label, line1, line2, city, state, country, pincode }]
  advancePayments      Json @default("[]") // [{ orderId, orderNumber, amount, date, notes }]

  createdById   Int?
  createdBy     User? @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([country, status])
}

// ─── v1 Office: Orders + Order items ──────────────────────────────────────────

model Order {
  id                      Int          @id @default(autoincrement())
  orderNumber             String       @unique
  customerId              Int
  customer                Customer     @relation(fields: [customerId], references: [id])
  fileNumber              String
  orderType               OrderType
  orderStatus             OrderStatus  @default(DRAFT)
  orderDate               DateTime
  expectedDeliveryDate    DateTime?
  proformaInvoiceNumber   String?      @unique
  buyerPONumber           String?
  currency                String       @default("USD")
  containerSize           String?
  containerNumber         String?
  totalCBM                Decimal      @default(0) @db.Decimal(14, 3)
  totalWeight             Decimal      @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal      @default(0) @db.Decimal(14, 2)
  finalAmount             Decimal      @default(0) @db.Decimal(14, 2)
  advanceReceived         Boolean      @default(false)
  advanceAmount           Decimal      @default(0) @db.Decimal(14, 2)
  advanceReceivedAt       DateTime?
  orderImages             Json         @default("[]")
  specialInstructions     String?
  internalNotes           String?
  attachments             Json         @default("[]")
  comments                Json         @default("[]")
  cancellationReason      String?
  cancelledAt             DateTime?
  cancelledById           Int?
  draftProgress           Int          @default(0)
  createdById             Int?
  createdBy               User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  finalizedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([fileNumber, orderStatus])
  @@index([orderDate])
}

model OrderItem {
  id                Int      @id @default(autoincrement())
  orderId           Int
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  companySKU        String
  buyerSKU          String?
  buyerDescription  String?
  itemDescription   String?
  itemCategory      String?
  collectionName    String?
  materials         Json     @default("[]")
  finishes          Json     @default("[]")
  itemCondition     String?
  hsnCode           String?
  barcodeText       String?
  barcodeImage      String?
  dimensions        Json?    // { length, width, height, unit }
  cbm               Decimal  @default(0) @db.Decimal(10, 3)
  totalCBM          Decimal  @default(0) @db.Decimal(12, 3)
  weight            Decimal  @default(0) @db.Decimal(10, 2)
  quantity          Int
  unitPrice         Decimal  @db.Decimal(14, 2)
  totalPrice        Decimal  @default(0) @db.Decimal(14, 2)
  images            Json     @default("[]")
  primaryImage      String?
  comments          Json     @default("[]")
  productionNotes   String?
  qcNotes           String?
  polishNotes       String?
  packagingNotes    String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companySKU])
}

// ─── v1 Office: Buyer catalogue ───────────────────────────────────────────────

model BuyerCatalogueFolder {
  id          Int      @id @default(autoincrement())
  buyerId     Int      // customer id
  fileNumber  String
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products BuyerCatalogueProduct[]

  @@unique([buyerId, fileNumber])
}

model BuyerCatalogueProduct {
  id                   Int                  @id @default(autoincrement())
  folderId             Int
  folder               BuyerCatalogueFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  sku                  String
  buyerSKU             String?
  buyerDescription     String?
  itemDescription      String?
  itemCategory         String?
  collectionName       String?
  materials            Json     @default("[]")
  finishes             Json     @default("[]")
  itemCondition        String?
  hsnCode              String?
  barcodeText          String?
  barcodeImage         String?
  dimensions           Json?
  cbm                  Decimal  @default(0) @db.Decimal(10, 3)
  weight               Decimal  @default(0) @db.Decimal(10, 2)
  images               Json     @default("[]")
  primaryImage         String?
  productionNotes      String?
  qcNotes              String?
  polishNotes          String?
  packagingNotes       String?
  firstOrderedAt       DateTime?
  lastOrderedAt        DateTime?
  totalTimesOrdered    Int      @default(0)
  totalQuantityOrdered Int      @default(0)
  currentPrice         Decimal  @default(0) @db.Decimal(14, 2)
  priceHistory         Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId, sku])
}

// ─── v2 Showroom: Locations / Products / Instances / Ledger ───────────────────

model Location {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  name      String
  type      LocationType
  parentId  Int?
  parent    Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[]   @relation("LocationHierarchy")
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users         User[]
  instances     ProductInstance[]
  ledgerEntries StockLedger[]
  sales         ShowroomSale[]
}

model Product {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  category     String?
  materialType MaterialType
  defaultUnit  String       @default("piece")
  description  String?
  basePrice    Decimal?     @db.Decimal(12, 2)
  baseImages   Json?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instances ProductInstance[]
}

model ProductInstance {
  id           Int     @id @default(autoincrement())
  instanceCode String  @unique
  productId    Int
  product      Product @relation(fields: [productId], references: [id])

  currentLocationId Int?
  currentLocation   Location?  @relation(fields: [currentLocationId], references: [id])
  currentStage      PieceStage @default(IN_SHOWROOM)

  arrivalDate      DateTime?
  listedPrice      Decimal?  @db.Decimal(12, 2)
  actualDimensions Json?
  photos           Json?
  qualityNotes     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations  Reservation[]
  sales         ShowroomSale[]
  ledgerEntries StockLedger[]

  @@index([currentLocationId, currentStage])
}

model StockLedger {
  id          BigInt           @id @default(autoincrement())
  voucherNo   String
  voucherType VoucherType
  instanceId  Int?
  instance    ProductInstance? @relation(fields: [instanceId], references: [id])
  productId   Int?
  locationId  Int
  location    Location         @relation(fields: [locationId], references: [id])
  quantity    Decimal          @db.Decimal(12, 3)
  postingDate DateTime         @default(now())
  remarks     String?
  createdById Int
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([instanceId, locationId])
  @@index([voucherNo])
  @@index([postingDate])
}

model Reservation {
  id            Int               @id @default(autoincrement())
  reservationNo String            @unique
  instanceId    Int
  instance      ProductInstance   @relation(fields: [instanceId], references: [id])
  customerName  String
  customerPhone String?
  customerEmail String?
  reservedById  Int
  reservedBy    User              @relation(fields: [reservedById], references: [id])
  reservedAt    DateTime          @default(now())
  holdUntil     DateTime?
  advancePaid   Decimal           @default(0) @db.Decimal(12, 2)
  status        ReservationStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ShowroomSale {
  id              Int             @id @default(autoincrement())
  saleNo          String          @unique
  instanceId      Int
  instance        ProductInstance @relation(fields: [instanceId], references: [id])
  showroomId      Int
  showroom        Location        @relation(fields: [showroomId], references: [id])
  customerName    String
  customerPhone   String?
  customerAddress String?
  salePrice       Decimal         @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  paymentMode     PaymentMode?
  paymentStatus   PaymentStatus   @default(PENDING)
  saleDate        DateTime        @default(now())
  dispatchStatus  DispatchStatus  @default(PENDING)
  soldById        Int
  soldBy          User            @relation(fields: [soldById], references: [id])
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([saleDate])
  @@index([showroomId, saleDate])
}

// ─── Showroom Products (legacy v1 showroom — kept so the existing Showroom
// pages keep working until they're migrated to v2 ProductInstance). ──────────

model ShowroomProduct {
  id             Int      @id @default(autoincrement())
  branch         String   // 'jhalamand' | 'kakani'
  section        String   // 'A' .. 'D'
  companySKU     String
  size           String?
  price          Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @default("INR")
  photos         Json     @default("[]")
  primaryImage   String?
  description    String?
  createdById    Int?
  modifiedById   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([branch, section])
  @@index([companySKU])
}

// ─── Voucher number sequences (one row per prefix per year) ──────────────────

model VoucherSequence {
  id     Int    @id @default(autoincrement())
  prefix String
  year   Int
  last   Int    @default(0)

  @@unique([prefix, year])
}
