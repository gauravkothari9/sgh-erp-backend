# =====================================================================
# Local development environment
# Loaded automatically when you run `npm run dev` (NODE_ENV=development).
# PM2 (production) ignores this file — it reads .env instead.
# =====================================================================

# Different port so it doesn't collide with anything else.
PORT=5001
NODE_ENV=development

# Local MongoDB. Install MongoDB Community Server, or use Docker:
#   docker run -d -p 27017:27017 --name sgh-mongo mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017/sgh_erp_dev

JWT_SECRET=local_dev_secret_change_only_if_you_want_to
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=local_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=14d

CLIENT_URL=http://localhost:5173

PUBLIC_API_URL=http://localhost:5001
UPLOAD_PATH=./uploads-dev
MAX_FILE_SIZE=10485760
