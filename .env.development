# =====================================================================
# Local development environment
# Loaded automatically when you run `npm run dev` (NODE_ENV=development).
# PM2 (production) ignores this file — it reads .env instead.
# =====================================================================

# Different port so it doesn't collide with PM2 on 5000.
PORT=5001
NODE_ENV=development

# Different DATABASE NAME, same MongoDB instance. Edits here can't touch prod.
MONGO_URI=mongodb://localhost:27017/sgh-erp-dev

# Same JWT settings — you can copy the secret from .env so logins work
# the same locally as in prod, OR keep this default while developing.
JWT_SECRET=local_dev_secret_change_only_if_you_want_to
JWT_EXPIRES_IN=7d

# CORS for the local Vite dev server.
CLIENT_URL=http://localhost:5173

# Public URL the dev backend serves files at — used to build absolute upload URLs.
PUBLIC_API_URL=http://localhost:5001

# Local uploads dir (don't write to prod's uploads).
UPLOAD_PATH=./uploads-dev
MAX_FILE_SIZE=10485760
